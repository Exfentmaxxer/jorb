# Database Configuration
DATABASE_URL="postgresql://jorb_user:jorb_password@localhost:5432/jorb_core?schema=public"

# OpenAI API Configuration
OPENAI_API_KEY=your-openai-api-key-here

# JWT Secret (will be auto-generated during installation)
JWT_SECRET=your-jwt-secret-here

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# ChromaDB Configuration
CHROMA_URL=http://localhost:8000

# Server Configuration
PORT=3000
NODE_ENV=development

# Memory Configuration
MEMORY_RETENTION_DAYS=30
MEMORY_CONSOLIDATION_INTERVAL=86400000

# Tool Configuration
TOOL_EXECUTION_TIMEOUT=30000
MAX_TOOL_RETRIES=3

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
