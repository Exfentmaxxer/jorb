{
  "name": "jorb-core",
  "version": "1.0.0",
  "description": "Jorb Core - Enterprise Agentic Operating System",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "mobile/*"
  ],
  "scripts": {
    "setup": "bash setup.sh",
    "setup:windows": "powershell -ExecutionPolicy Bypass -File setup.ps1",
    "start": "cd packages/backend && npm run start:prod",
    "dev": "cd packages/backend && npm run start:dev",
    "dev:landing": "cd apps/landing && npm run dev",
    "start:landing": "cd apps/landing && npm run start",
    "start:all": "concurrently \"npm run start\" \"npm run start:landing\"",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:restart": "docker-compose restart",
    "services:start": "docker-compose up -d postgres redis chromadb",
    "services:stop": "docker-compose stop postgres redis chromadb",
    "migrate": "cd packages/backend && npx prisma migrate deploy",
    "migrate:dev": "cd packages/backend && npx prisma migrate dev",
    "prisma:studio": "cd packages/backend && npx prisma studio",
    "prisma:generate": "cd packages/backend && npx prisma generate",
    "seed": "cd packages/backend && npm run seed",
    "clean": "rm -rf node_modules packages/*/node_modules apps/*/node_modules packages/*/dist apps/*/.next",
    "clean:docker": "docker-compose down -v"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "prettier": "^3.1.0",
    "turbo": "^1.11.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
