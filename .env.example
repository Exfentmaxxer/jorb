# Database
DATABASE_URL=postgresql://jorb_user:jorb_password_dev@localhost:5432/jorb_core

# Redis
REDIS_URL=redis://localhost:6379

# ChromaDB
CHROMA_URL=http://localhost:8000

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRATION=7d

# API
PORT=3000
NODE_ENV=development
API_PREFIX=/api/v1

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# OpenAI (for embeddings and LLM calls)
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Logging
LOG_LEVEL=info

# CORS
CORS_ORIGINS=http://localhost:3001,http://localhost:3002

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# Memory System
MEMORY_EMBEDDING_DIMENSION=1536
MEMORY_MAX_SHORT_TERM=100
MEMORY_MAX_MID_TERM=1000
MEMORY_PRUNING_THRESHOLD=0.3

# Tool Execution
TOOL_TIMEOUT_MS=30000
TOOL_MAX_RETRIES=3
TOOL_SANDBOX_ENABLED=true
